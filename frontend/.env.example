# Bu dosyayı .env olarak kopyalayın.
# Vite yalnızca VITE_ ile başlayan değişkenleri tarayıcı koduna açar.
VITE_API_URL=http://127.0.0.1:8000

# Cihaz QR etiketlerine yazılan adres (E5). Telefonla okutulacaksa uygulamanın ağdaki adresi
# verilmeli; localhost telefonda açılmaz. Boşsa tarayıcının o anki adresi kullanılır.
# VITE_PUBLIC_URL=http://192.168.1.20:5173
