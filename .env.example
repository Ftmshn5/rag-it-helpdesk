# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin.
# .env hem docker-compose hem de uygulama (pydantic-settings) tarafından okunur.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=it_support
POSTGRES_PASSWORD=it_support_dev
POSTGRES_DB=it_support
POSTGRES_PORT=5432

# --- Uygulama ---
APP_NAME=IT Destek ve Envanter Otomasyonu
DEBUG=true
DATABASE_URL=postgresql+psycopg://it_support:it_support_dev@localhost:5432/it_support

# --- Ekran görüntüsü yükleme ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI ---
AI_CONFIDENCE_THRESHOLD=0.6
# fake: anahtar kelimeli sahte AI | rag: Ollama + pgvector (önce "ollama pull" ve indeksleme gerekir)
AI_PROVIDER=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
RAG_TOP_K=4
# Güven skoru = benzerliğin [FLOOR, CEILING] aralığındaki yeri (ölçülerek ayarlanır)
RAG_SIMILARITY_FLOOR=0.45
RAG_SIMILARITY_CEILING=0.75

# --- Frontend (CORS) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
