# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin.
# .env hem docker-compose hem de uygulama (pydantic-settings) tarafından okunur.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=it_support
POSTGRES_PASSWORD=it_support_dev
POSTGRES_DB=it_support
POSTGRES_PORT=5432

# --- Uygulama ---
APP_NAME=IT Destek ve Envanter Otomasyonu
DEBUG=true
DATABASE_URL=postgresql+psycopg://it_support:it_support_dev@localhost:5432/it_support

# --- Ekran görüntüsü yükleme ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=5

# --- AI ---
AI_CONFIDENCE_THRESHOLD=0.6

# --- Frontend (CORS) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
